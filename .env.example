DATABASE_URL=postgresql://adondesalimos:adondesalimos_dev_2026@localhost:5439/adondesalimos

# Google Places API (New) — la usa la Ficha (spec 4) para horarios/rating/foto en vivo.
# Key server-only (nunca en el bundle del browser). Sacarla de Google Cloud Console,
# restringida a "Places API (New)". El valor real va en .env (gitignoreado), no acá.
GOOGLE_PLACES_API_KEY=

# ── Auth (spec AUTH — better-auth + Resend). Todas server-only. ──────────────────
# Secreto de firma de sesiones. Generar con: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL base de la app (la usa better-auth para armar links de mail y validar origen).
# En dev con ngrok: https://adondesalimos.ngrok.app
BETTER_AUTH_URL=
# Email del único admin (decisión 8): habilita /admin. Sin setear, /admin es 404 para todos.
ADMIN_EMAIL=
# API key de Resend para los mails transaccionales (verificación, reset).
RESEND_API_KEY=
# Sender de los mails. Dev: onboarding@resend.dev (sandbox). Prod: dominio verificado.
# RESEND_FROM_EMAIL=
# Google OAuth (opcional): sin estas dos, el login con Google no se registra ni se muestra.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Orígenes extra confiables para CSRF de better-auth, separados por coma (opcional).
# BETTER_AUTH_TRUSTED_ORIGINS=

# ── Fotos del dueño en Cloudflare R2 (AUTH F3, decisión 16). Server-only: las lee
#    SOLO lib/storage/r2.ts, nunca llegan al bundle del browser. ──────────────────
# Account ID de Cloudflare: arma el endpoint https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Credenciales del API token de R2 (permiso de lectura/escritura sobre el bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket donde viven las fotos.
R2_BUCKET=
# Dominio público del bucket (r2.dev o dominio propio). Es la base de las URLs que
# se guardan en place_photos.url y desde donde el browser sirve las fotos.
R2_PUBLIC_URL=

# ── MercadoPago (spec MONETIZACION). El cobro (F2) las usa; F1 no. Las dos
#    primeras son server-only: las lee SOLO lib/billing/mercadopago.ts (F2), nunca
#    llegan al bundle. La tercera es pública por diseño (la necesita el brick). ───
# Access token de la app de MP (Bearer de la API). Server-only.
MP_ACCESS_TOKEN=
# Secreto de firma del webhook (panel de MP → Webhooks). ≠ el access token.
# Valida el x-signature de los avisos de MP (HMAC). Server-only.
MP_WEBHOOK_SECRET=
# Public key de la app de MP. La usa el Card Payment Brick para tokenizar la
# tarjeta en el browser. Pública por diseño (por eso el prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_MP_PUBLIC_KEY=
